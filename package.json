{
  "name": "@dmitriyzverev/eslint-config",
  "version": "4.0.0",
  "description": "An ESLint configuration used in packages within the @dmitriyzverev scope",
  "keywords": [
    "eslint",
    "eslintconfig",
    "eslint-config",
    "flat-config",
    "typescript",
    "react",
    "prettier"
  ],
  "homepage": "https://github.com/DmitriyZverev/eslint-config",
  "bugs": {
    "url": "https://github.com/DmitriyZverev/eslint-config/issues",
    "email": "opensource@zver.dev"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js"
  },
  "author": {
    "name": "Dmitriy Zverev",
    "email": "opensource@zver.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DmitriyZverev/eslint-config.git"
  },
  "scripts": {
    "build": "rm -rf .package && npx tsc --outDir .package  && cp -r package.json LICENSE README.md .package",
    "formatter:fix": "prettier --write .",
    "formatter:check": "prettier --check .",
    "analyzer:api:check": "npx api-extractor run --local --verbose",
    "test": "npm run build && tsc -p tsconfig.test.json && tsc -p test/fixtures && node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@stylistic/eslint-plugin": "^2.0.0 || ^3.0.0 || ^4.0.0 || ^5.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.0.0 || ^6.1.0 || ^7.0.0"
  },
  "devDependencies": {
    "@dmitriyzverev/prettier-config": "3.0.1",
    "@dmitriyzverev/typescript-config": "1.1.1",
    "@microsoft/api-extractor": "7.59.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "eslint": "9.39.5",
    "json-stringify-pretty-compact": "4.0.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "eslint": "^9.7.0",
    "typescript": "^4.8.4 || ^5.0.0"
  }
}
